# --- Postgres ---
# Prisma CLI/migrations read DATABASE_URL (or DIRECT_URL) from here.
# The Nuxt server reads NUXT_DATABASE_URL; keep it equal to DATABASE_URL.
# Use Supavisor (port 5432, session mode). Direct too-large connections fail on serverless.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
NUXT_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- Nuxt / auth (mirrors runtimeConfig.*; .dev.vars for Wrangler local dev) ---
NUXT_SESSION_PASSWORD=<32+ random chars>
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# --- Cloudflare R2 (presigned upload/download only) ---
NUXT_R2_ACCOUNT_ID=
NUXT_R2_ACCESS_KEY_ID=
NUXT_R2_SECRET_ACCESS_KEY=
NUXT_R2_BUCKET=semestria-files
