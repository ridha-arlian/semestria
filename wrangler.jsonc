{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "semestria",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./.output/public/",
    "not_found_handling": "none"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "592337cee7bd43e9ae26b17112895929",
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "semestria-files"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  },
}
